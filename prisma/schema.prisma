// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
    user_id             String                @id @default(uuid())
    auth_id             String                @unique
    email               String                @unique
    given_name          String
    family_name         String
    accounts            Account[]
    plannedTransactions PlannedTransaction[]
    categories          UserDefinedCategory[]
    tags                Tag[]
    budgets             Budget[]

    @@map("user")
}

model Account {
    account_id          String  @id @default(uuid())
    external_account_id String? @unique
    display_name        String // nickname provided by user or default to external
    external_name       String? // "real" name provided by institution
    mask                String?
    type                String
    subtype             String
    current_balance     Float?
    available_balance   Float?
    iso_currency_code   String?

    partitions   AccountPartition[]
    savings_goal SavingsGoal?

    // relations
    plaid_item           PlaidItem?           @relation(fields: [plaid_item_id], references: [plaid_item_id])
    plaid_item_id        String?
    User                 User                 @relation(fields: [user_id], references: [user_id])
    user_id              String
    TransactionsAsTarget PlannedTransaction[] @relation("TargetAccount")
    TransactionsAsOrigin PlannedTransaction[] @relation("OriginAccount")
    Budget               Budget[]

    @@map("account")
}

model AccountPartition {
    account_partition_id String @id @default(uuid())
    name                 String // nickname provided by user or default to external
    current_balance      Float

    account_id   String
    Account      Account?     @relation(fields: [account_id], references: [account_id])
    savings_goal SavingsGoal?

    TransactionsAsTarget PlannedTransaction[] @relation("TargetAccountPartition")
    TransactionsAsOrigin PlannedTransaction[] @relation("OriginAccountPartition")

    @@map("account_partition")
}

model PlaidItem {
    plaid_item_id  String    @id
    access_token   String
    accounts       Account[]
    institution_id String?

    @@map("plaid_item")
}

model SavingsGoal {
    savings_goal_id      String            @id @default(uuid())
    target_balance       Float
    target_date          DateTime?
    schedule_details     Json?
    Account              Account?          @relation(fields: [account_id], references: [account_id])
    account_id           String?           @unique
    AccountPartition     AccountPartition? @relation(fields: [account_partition_id], references: [account_partition_id])
    account_partition_id String?           @unique
}

enum PlannedTransactionType {
    CREDIT
    DEBIT
    TRANSFER
}

enum RecurrenceType {
    SCHEDULE
    TRIGGER
}

model PlannedTransaction {
    planned_transaction_id      String                 @id @default(uuid())
    memo                        String
    type                        PlannedTransactionType
    amount                      Float
    schedule                    Json?
    trigger                     Json?
    recurrence_type             RecurrenceType
    // user
    User                        User                   @relation(fields: [user_id], references: [user_id])
    user_id                     String
    // accounts
    TargetAccount               Account                @relation(name: "TargetAccount", fields: [target_account_id], references: [account_id])
    OriginAccount               Account?               @relation(name: "OriginAccount", fields: [origin_account_id], references: [account_id])
    target_account_id           String
    origin_account_id           String?
    TargetAccountPartition      AccountPartition?       @relation(name: "TargetAccountPartition", fields: [target_account_partition_id], references: [account_partition_id])
    OriginAccountPartition      AccountPartition?      @relation(name: "OriginAccountPartition", fields: [origin_account_partition_id], references: [account_partition_id])
    target_account_partition_id String?
    origin_account_partition_id String?

    category_id String
    tags        Tag[]
}

model UserDefinedCategory {
    category_id        String @id @default(uuid())
    parent_category_id String // References a system defined category
    name               String
    user               User   @relation(fields: [user_id], references: [user_id])
    user_id            String
}

model Tag {
    tag_id              String               @id @default(uuid())
    name                String
    user                User                 @relation(fields: [user_id], references: [user_id])
    user_id             String
    PlannedTransactions PlannedTransaction[]
}

model Budget {
    budget_id   String  @id @default(uuid())
    name        String
    description String?
    schedule    Json
    amount      Float
    num_months  Int

    category_id             String
    User                    User    @relation(fields: [user_id], references: [user_id])
    user_id                 String
    SystemEventAccount      Account @relation(fields: [system_event_account_id], references: [account_id])
    system_event_account_id String
}
