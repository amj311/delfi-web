model BudgetChildItem {
    budget_child_item_id String   @id @default(uuid())
    created_at           DateTime @default(now())
    updated_at           DateTime @default(now()) @updatedAt

    budget_id String
    Budget    Budget @relation(fields: [budget_id], references: [budget_id])

    amount            Float
    date              String // DATE ONLY  e.g. "2023-10-01"
    date_order        String? // For sorting transaction from the same date, since time info is not always available. IE 2025-04-12-01 (e.g. 01 for the first transaction of the day)
    authorized_date   String? // e.g. for credit card transactions, the date the transaction was authorized
    iso_currency_code String?
    memo              String
    transaction_type  BudgetTransactionType

    // accounts
    TargetAccount               Account           @relation(name: "BudgetChildTargetAccount", fields: [account_id], references: [account_id])
    OriginAccount               Account?          @relation(name: "BudgetChildOriginAccount", fields: [origin_account_id], references: [account_id])
    account_id                  String
    origin_account_id           String?
    TargetAccountPartition      AccountPartition? @relation(name: "BudgetChildTargetAccountPartition", fields: [target_account_partition_id], references: [account_partition_id])
    OriginAccountPartition      AccountPartition? @relation(name: "BudgetChildOriginAccountPartition", fields: [origin_account_partition_id], references: [account_partition_id])
    target_account_partition_id String?
    origin_account_partition_id String?

    Category                Category?                @relation(fields: [category_id], references: [category_id])
    category_id             String?
    Tags                    Tag[]                    @relation("BudgetChildTags")
    TransactionAttributions TransactionAttribution[]
    Group                   BudgetGroup?             @relation(fields: [group_id], references: [group_id])
    group_id                String?
}

enum CategoryType {
    EXPENSE
    INCOME
    TRANSFER
}

model Category {
    category_id String   @id @default(uuid())
    created_at  DateTime @default(now())
    updated_at  DateTime @default(now()) @updatedAt

    name  String
    type  CategoryType
    icon  String?
    color String?

    Workspace    Workspace? @relation(fields: [workspace_id], references: [workspace_id])
    workspace_id String

    Budgets                  Budget[]
    TransactionAttributions  TransactionAttribution[]
    CategoryDetectionMapping CategoryDetectionMapping[]

    ParentCategory     Category?         @relation("CategoryHierarchy", fields: [parent_category_id], references: [category_id])
    Children           Category[]        @relation("CategoryHierarchy")
    parent_category_id String?
    BudgetChildItem    BudgetChildItem[]
}

model CategoryDetectionMapping {
    Workspace    Workspace? @relation(fields: [workspace_id], references: [workspace_id])
    workspace_id String

    detection_key String // system category key
    Category      Category @relation(fields: [category_id], references: [category_id])
    category_id   String

    @@id([workspace_id, detection_key])
}

model Tag {
    tag_id     String   @id @default(uuid())
    created_at DateTime @default(now())
    updated_at DateTime @default(now()) @updatedAt

    name                    String
    Workspace               Workspace?               @relation(fields: [workspace_id], references: [workspace_id])
    workspace_id            String
    Budgets                 Budget[]                 @relation("BudgetTags")
    TransactionAttributions TransactionAttribution[] @relation("TransactionTags")
    BudgetChildItem         BudgetChildItem[]        @relation("BudgetChildTags")
}

model BudgetGroup {
    group_id   String   @id @default(uuid())
    created_at DateTime @default(now())
    updated_at DateTime @default(now()) @updatedAt

    name                    String
    color                   String?
    Workspace               Workspace                @relation(fields: [workspace_id], references: [workspace_id])
    workspace_id            String
    Budgets                 Budget[]
    TransactionAttributions TransactionAttribution[]
    BudgetChildItem         BudgetChildItem[]

    @@map("Group")
}

// Real transaction, created manually or imported from source (plaid)
model Transaction {
    transaction_id String   @id @default(uuid())
    created_at     DateTime @default(now())
    updated_at     DateTime @default(now()) @updatedAt

    amount               Float
    date                 String // DATE ONLY  e.g. "2023-10-01"
    date_order           String? // For sorting transaction from the same date, since time info is not always available. IE 2025-04-12-01 (e.g. 01 for the first transaction of the day)
    authorized_date      String? // e.g. for credit card transactions, the date the transaction was authorized
    budget_date          String? // optional date for counting a transaction toward a specific budget occurrence
    iso_currency_code    String?
    notes                String?
    original_description String // e.g. "Starbucks 1234"
    pending              Boolean @default(false)
    done_pending         Boolean @default(false) // e.g. if the transaction was pending, but has been processed. Pending should also be true

    location_address String? // e.g. "123 Main St, Anytown, USA"
    location_lat     Float? // e.g. 37.7749
    location_lon     Float? // e.g. -122.4194
    location_city    String? // e.g. "San Francisco"
    location_region  String? // e.g. "CA"
    location_postal  String? // e.g. "94103"

    account_balance Float? // The account balance at the time of the transaction, if available

    source      String // e.g. "plaid", "manual", "imported"
    source_id   String? // e.g. plaid transaction id, manual transaction id, imported transaction id
    source_data Json? // e.g. plaid transaction data, imported transaction data
    plaid_data  Json? // e.g. plaid transaction data, if available

    // A single transaction cannot be split between accounts
    Account      Account                  @relation(fields: [account_id], references: [account_id])
    account_id   String
    Merchant     Merchant?                @relation(fields: [merchant_id], references: [merchant_id])
    merchant_id  String?
    Attributions TransactionAttribution[]

    PendingTransaction     Transaction? @relation("PendingCompletedTransaction", fields: [pending_transaction_id], references: [transaction_id])
    CompletedTransaction   Transaction? @relation("PendingCompletedTransaction")
    pending_transaction_id String?      @unique

    Workspace    Workspace @relation(fields: [workspace_id], references: [workspace_id])
    workspace_id String

    TransferPair      Transaction?       @relation("TransferPair", fields: [transfer_pair_id], references: [transaction_id])
    TransferPairSelf  Transaction?       @relation("TransferPair")
    transfer_pair_id  String?            @unique
    TransactionReview TransactionReview?
    deleted_at        DateTime? // soft delete
}

// To keep like data all in one place, this table holds data for ALL transactions, even without splits
// Data w/o splits just have a single entry, and splits have multiple
model TransactionAttribution {
    transaction_attribution_id String   @id @default(uuid())
    created_at                 DateTime @default(now())
    updated_at                 DateTime @default(now()) @updatedAt

    amount Float // TODO ADD MANY CHECKS THAT THESE ALWAYS ADD UP TO THE TRANSACTION AMOUNT
    memo   String?

    Transaction    Transaction @relation(fields: [transaction_id], references: [transaction_id])
    transaction_id String

    AccountPartition     AccountPartition? @relation(fields: [account_partition_id], references: [account_partition_id])
    account_partition_id String?
    Category             Category?         @relation(fields: [category_id], references: [category_id])
    category_id          String?
    Tags                 Tag[]             @relation("TransactionTags")
    Budget               Budget?           @relation(fields: [budget_id], references: [budget_id])
    budget_id            String?
    Group                BudgetGroup?      @relation(fields: [group_id], references: [group_id])
    group_id             String?
    BudgetChildItem      BudgetChildItem?  @relation(fields: [budget_child_item_id], references: [budget_child_item_id])
    budget_child_item_id String?
}

model Merchant {
    merchant_id String   @id @default(uuid())
    created_at  DateTime @default(now())
    updated_at  DateTime @default(now()) @updatedAt

    name     String
    hostname String? // e.g. "starbucks.com" no https
    logo     String?

    plaid_merchant_id String? // e.g. plaid merchant id, manual merchant id, imported merchant id
    detection_key     String? // e.g. "Food & Drink"
    Transaction       Transaction[]
}

model TransactionRule {
    transaction_rule_id String   @id @default(uuid())
    created_at          DateTime @default(now())
    updated_at          DateTime @default(now()) @updatedAt

    workspace_id String?
    Workspace    Workspace?              @relation(fields: [workspace_id], references: [workspace_id])
    filter       Json // e.g. filter to apply to transactions, like category, amount, etc.
    actions      TransactionRuleAction[]
}

model TransactionRuleAction {
    transaction_rule_action_id String   @id @default(uuid())
    created_at                 DateTime @default(now())
    updated_at                 DateTime @default(now()) @updatedAt

    transaction_rule_id String
    TransactionRule     TransactionRule @relation(fields: [transaction_rule_id], references: [transaction_rule_id])

    action String // e.g. "budget_id"
    value  Json? // JSON object containing the value to set, e.g. { "budget_id": "uuid" }
}

model TransactionReview {
    transaction_review_id String   @id @default(uuid())
    created_at            DateTime @default(now())
    updated_at            DateTime @default(now()) @updatedAt

    transaction_id String      @unique
    Transaction    Transaction @relation(fields: [transaction_id], references: [transaction_id])
    Workspace      Workspace   @relation(fields: [workspace_id], references: [workspace_id])
    workspace_id   String

    AssignedTo     User?     @relation(name: "AssignedTo", fields: [assigned_to_id], references: [user_id])
    assigned_to_id String?
    ReviewedBy     User?     @relation(name: "ReviewedBy", fields: [reviewed_by_id], references: [user_id])
    reviewed_by_id String?
    reviewed_at    DateTime?
    dismissed_at   DateTime?
}
