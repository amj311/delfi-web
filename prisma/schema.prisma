// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
    user_id    String   @id @default(uuid())
    created_at DateTime @default(now())
    updated_at DateTime @default(now()) @updatedAt

    auth_id            String              @unique
    email              String              @unique
    given_name         String
    family_name        String
    Workspaces         Workspace[]
    AssignedReviews    TransactionReview[] @relation("AssignedTo")
    TransactionReviews TransactionReview[] @relation("ReviewedBy")
}

model Workspace {
    workspace_id String   @id @default(uuid())
    created_at   DateTime @default(now())
    updated_at   DateTime @default(now()) @updatedAt

    name  String
    Users User[]

    Connections               Connection[]
    accounts                  Account[]
    Budgets                   Budget[]
    categories                Category[]
    tags                      Tag[]
    Transactions              Transaction[]
    PlaidItems                PlaidItem[]
    CategoryDetectionMappings CategoryDetectionMapping[]
    Groups                    BudgetGroup[]
    TransactionRules          TransactionRule[]
    TransactionReviews        TransactionReview[]
}

model Institution {
    institution_id String   @id @default(uuid())
    created_at     DateTime @default(now())
    updated_at     DateTime @default(now()) @updatedAt

    name                 String
    logo                 String?
    plaid_institution_id String?      @unique // e.g. plaid institution id
    loginUrl             String? // e.g. institution login url
    scraper              String? // e.g. "finicity", "mx", etc.
    Account              Account[]
    Connections          Connection[]
}

enum ConnectionStatus {
    CONNECTED
    DISCONNECTED
    ERROR
}

model Connection {
    created_at DateTime @default(now())
    updated_at DateTime @default(now()) @updatedAt

    status         ConnectionStatus @default(CONNECTED)
    otp_waiting    Boolean          @default(false)
    otp_expires_at DateTime?
    // external_connection_id String? @map("externalConnectionId") // e.g. plaid connection id

    Workspace    Workspace @relation(fields: [workspace_id], references: [workspace_id])
    workspace_id String

    Institution    Institution @relation(fields: [institution_id], references: [institution_id])
    institution_id String

    @@unique([institution_id, workspace_id], name: "institution_workspace_unique")
}

model PlaidItem {
    plaid_item_id String   @id
    created_at    DateTime @default(now())
    updated_at    DateTime @default(now()) @updatedAt

    plaid_institution_id String
    access_token         String
    accounts             Account[]
    Workspace            Workspace? @relation(fields: [workspace_id], references: [workspace_id])
    workspace_id         String?
}

model Account {
    account_id String   @id @default(uuid())
    created_at DateTime @default(now())
    updated_at DateTime @default(now()) @updatedAt

    external_account_id String?
    display_name        String? // nickname provided by user or default to external
    external_name       String // "real" name provided by institution
    mask                String?
    type                String
    subtype             String
    current_balance     Float
    available_balance   Float?
    limit               Float? // e.g. credit card limit
    apy                 Float? // e.g. savings account APY
    apr                 Float? // e.g. credit card APR
    iso_currency_code   String?

    partitions            AccountPartition[]
    savings_goal          SavingsGoal?
    never_request_reviews Boolean            @default(false)
    sync_cadence_hours    Int                @default(24) // how often to sync this account, in hours

    source      String // e.g. "plaid", "manual", "imported"
    source_id   String? // e.g. plaid account id, manual account id, imported account id
    source_data Json? // e.g. plaid account data, manual account data, imported account data

    last_successful_sync DateTime? // e.g. last time the account was synced with plaid or other source
    last_failed_sync     DateTime? // e.g. last time the account sync failed
    sync_error           String? // e.g. error message from last failed sync
    archived             Boolean?            @default(false) // whether the account is archived (soft delete)
    // relations
    Workspace            Workspace?          @relation(fields: [workspace_id], references: [workspace_id])
    workspace_id         String
    Institution          Institution?        @relation(fields: [institution_id], references: [institution_id])
    institution_id       String?
    PlaidItem            PlaidItem?          @relation(fields: [plaid_item_id], references: [plaid_item_id])
    plaid_item_id        String?
    plaid_account_id     String?
    BudgetsAsTarget      Budget[]            @relation("TargetAccount")
    BudgetsAsOrigin      Budget[]            @relation("OriginAccount")
    BudgetChildAsTarget  BudgetChildItem[]   @relation("BudgetChildTargetAccount")
    BudgetChildAsOrigin  BudgetChildItem[]   @relation("BudgetChildOriginAccount")
    Transaction          Transaction[]
    BalanceAdjustment    BalanceAdjustment[]
    BalanceRecord        BalanceRecord[]
}

// Reports the recorded balance for an account at a given date, based on scraper data.
// Intended to be useful for tracking the value of investment accounts over time when precise transactions are not available.
model BalanceRecord {
    balance_report_id String   @id @default(uuid())
    created_at        DateTime @default(now())
    updated_at        DateTime @default(now()) @updatedAt

    date       DateTime
    balance    Float
    Account    Account  @relation(fields: [account_id], references: [account_id])
    account_id String
}

// Especially for Partitions, which the user can control the balance of at will
// Allows the balance to be specified for different points in time, so past balances still exist
model BalanceAdjustment {
    // TODO is this ever needed for accounts?
    // maybe only for manual accounts?
    // If they are synced externally, do we save periodic balances as sanity checks?

    balance_adjustment_id String   @id @default(uuid())
    created_at            DateTime @default(now())
    updated_at            DateTime @default(now()) @updatedAt

    date                 DateTime
    amount               Float
    balance              Float // balance after this adjustment
    Account              Account?          @relation(fields: [account_id], references: [account_id])
    account_id           String?
    AccountPartition     AccountPartition? @relation(fields: [account_partition_id], references: [account_partition_id])
    account_partition_id String?
}

model AccountPartition {
    account_partition_id String   @id @default(uuid())
    created_at           DateTime @default(now())
    updated_at           DateTime @default(now()) @updatedAt

    name            String // nickname provided by user or default to external
    current_balance Float

    account_id   String
    Account      Account?     @relation(fields: [account_id], references: [account_id])
    savings_goal SavingsGoal?

    BudgetsAsTarget        Budget[]                 @relation("TargetAccountPartition")
    BudgetsAsOrigin        Budget[]                 @relation("OriginAccountPartition")
    BudgetChildAsTarget    BudgetChildItem[]        @relation("BudgetChildTargetAccountPartition")
    BudgetChildAsOrigin    BudgetChildItem[]        @relation("BudgetChildOriginAccountPartition")
    BalanceAdjustment      BalanceAdjustment[]
    TransactionAttribution TransactionAttribution[]
}

model SavingsGoal {
    savings_goal_id String   @id @default(uuid())
    created_at      DateTime @default(now())
    updated_at      DateTime @default(now()) @updatedAt

    target_balance       Float
    target_date          DateTime?
    schedule_details     Json?
    Account              Account?          @relation(fields: [account_id], references: [account_id])
    account_id           String?           @unique
    AccountPartition     AccountPartition? @relation(fields: [account_partition_id], references: [account_partition_id])
    account_partition_id String?           @unique
}

enum BudgetTransactionType {
    TRANSACTION
    INCOME
    EXPENSE
    SAVINGS
    TRANSFER
}

enum RecurrenceType {
    SCHEDULE
    TRIGGER
}

model Budget {
    budget_id  String   @id @default(uuid())
    created_at DateTime @default(now())
    updated_at DateTime @default(now()) @updatedAt

    memo             String
    notes            String?
    transaction_type BudgetTransactionType
    recurrence_type  RecurrenceType

    scheduleVariants BudgetScheduleVariant[]
    // triggerVariants  BudgetTriggerVariant[]

    // workspace
    Workspace    Workspace? @relation(fields: [workspace_id], references: [workspace_id])
    workspace_id String

    // accounts
    TargetAccount               Account           @relation(name: "TargetAccount", fields: [account_id], references: [account_id])
    OriginAccount               Account?          @relation(name: "OriginAccount", fields: [origin_account_id], references: [account_id])
    account_id                  String
    origin_account_id           String?
    TargetAccountPartition      AccountPartition? @relation(name: "TargetAccountPartition", fields: [target_account_partition_id], references: [account_partition_id])
    OriginAccountPartition      AccountPartition? @relation(name: "OriginAccountPartition", fields: [origin_account_partition_id], references: [account_partition_id])
    target_account_partition_id String?
    origin_account_partition_id String?

    Category                Category?                @relation(fields: [category_id], references: [category_id])
    category_id             String?
    Tags                    Tag[]                    @relation("BudgetTags")
    TransactionAttributions TransactionAttribution[]
    Group                   BudgetGroup?             @relation(fields: [group_id], references: [group_id])
    group_id                String?
    childItems              BudgetChildItem[]
}

model BudgetScheduleVariant {
    schedule_variant_id String   @id @default(uuid())
    created_at          DateTime @default(now())
    updated_at          DateTime @default(now()) @updatedAt

    Budget    Budget @relation(fields: [budget_id], references: [budget_id])
    budget_id String

    amount_type   String @default("fixed") // e.g. "fixed", "triggered", "seasonal"
    amount        Float? // for fixed amounts
    month_amounts Json? // for monthly amounts

    // For triggered amounts
    trigger_filter   Json? // e.g. filter to apply to transactions, like category, amount, etc.
    trigger_operator String? // e.g. add, subtract, multiply, divide
    trigger_operand  Float?

    schedule           Json // e.g. cron expression, interval, etc.
    projectionSchedule Json? // e.g. cron expression, interval, etc. for projections
    // window_interval     String?
    // window_quantity     Int?
    // projection_interval String?
    // projection_quantity Int?

	notes String?
}

