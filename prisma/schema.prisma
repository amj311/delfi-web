// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
    user_id     String      @id @default(uuid())
    auth_id     String      @unique
    email       String      @unique
    given_name  String
    family_name String
    Workspaces  Workspace[]
}

model Workspace {
    workspace_id String @id @default(uuid())
    name         String
    Users        User[]

    accounts                 Account[]
    Budgets                  Budget[]
    categories               Category[]
    tags                     Tag[]
    Transaction              Transaction[]
    PlaidItem                PlaidItem[]
    CategoryGroup            CategoryGroup[]
    CategoryDetectionMapping CategoryDetectionMapping[]
    Group                    Group[]
}

model Institution {
    institution_id       String    @id @default(uuid())
    name                 String
    logo                 String?
    plaid_institution_id String?   @unique // e.g. plaid institution id
    Account              Account[]
}

model PlaidItem {
    plaid_item_id        String     @id
    plaid_institution_id String
    access_token         String
    accounts             Account[]
    Workspace            Workspace? @relation(fields: [workspace_id], references: [workspace_id])
    workspace_id         String?
}

model Account {
    account_id          String  @id @default(uuid())
    external_account_id String?
    display_name        String? // nickname provided by user or default to external
    external_name       String // "real" name provided by institution
    mask                String?
    type                String
    subtype             String
    current_balance     Float
    available_balance   Float?
    limit               Float? // e.g. credit card limit
    apy                 Float? // e.g. savings account APY
    iso_currency_code   String?

    partitions   AccountPartition[]
    savings_goal SavingsGoal?

    source      String // e.g. "plaid", "manual", "imported"
    source_id   String? // e.g. plaid account id, manual account id, imported account id
    source_data Json? // e.g. plaid account data, manual account data, imported account data

    created_at           DateTime  @default(now())
    last_successful_sync DateTime? // e.g. last time the account was synced with plaid or other source
    last_failed_sync     DateTime? // e.g. last time the account sync failed
    sync_error           String? // e.g. error message from last failed sync

    // relations
    Workspace         Workspace?          @relation(fields: [workspace_id], references: [workspace_id])
    workspace_id      String
    Institution       Institution?        @relation(fields: [institution_id], references: [institution_id])
    institution_id    String?
    PlaidItem         PlaidItem?          @relation(fields: [plaid_item_id], references: [plaid_item_id])
    plaid_item_id     String?
    plaid_account_id  String?
    BudgetsAsTarget   Budget[]            @relation("TargetAccount")
    BudgetsAsOrigin   Budget[]            @relation("OriginAccount")
    Transaction       Transaction[]
    BalanceAdjustment BalanceAdjustment[]
}

// Especially for Partitions, which the user can control the balance of a will
// Allows the balance to be specified for different points in time, so past balances still exist
model BalanceAdjustment {
    // TODO is this ever needed for accounts?
    // maybe only for manual accounts?
    // If they are synced externally, do we save periodic balances as sanity checks?

    balance_adjustment_id String            @id @default(uuid())
    date                  DateTime
    amount                Float
    balance               Float // balance after this adjustment
    Account               Account?          @relation(fields: [account_id], references: [account_id])
    account_id            String?
    AccountPartition      AccountPartition? @relation(fields: [account_partition_id], references: [account_partition_id])
    account_partition_id  String?
}

model AccountPartition {
    account_partition_id String @id @default(uuid())
    name                 String // nickname provided by user or default to external
    current_balance      Float

    account_id   String
    Account      Account?     @relation(fields: [account_id], references: [account_id])
    savings_goal SavingsGoal?

    BudgetsAsTarget        Budget[]                 @relation("TargetAccountPartition")
    BudgetsAsOrigin        Budget[]                 @relation("OriginAccountPartition")
    BalanceAdjustment      BalanceAdjustment[]
    TransactionAttribution TransactionAttribution[]
}

model SavingsGoal {
    savings_goal_id      String            @id @default(uuid())
    target_balance       Float
    target_date          DateTime?
    schedule_details     Json?
    Account              Account?          @relation(fields: [account_id], references: [account_id])
    account_id           String?           @unique
    AccountPartition     AccountPartition? @relation(fields: [account_partition_id], references: [account_partition_id])
    account_partition_id String?           @unique
}

enum BudgetTransactionType {
    TRANSACTION
    TRANSFER
}

enum RecurrenceType {
    SCHEDULE
    TRIGGER
}

model Budget {
    budget_id        String                @id @default(uuid())
    memo             String
    transaction_type BudgetTransactionType
    recurrence_type  RecurrenceType

    scheduleVariants BudgetScheduleVariant[]
    triggerVariants  BudgetTriggerVariant[]

    // workspace
    Workspace    Workspace? @relation(fields: [workspace_id], references: [workspace_id])
    workspace_id String

    // accounts
    TargetAccount               Account           @relation(name: "TargetAccount", fields: [account_id], references: [account_id])
    OriginAccount               Account?          @relation(name: "OriginAccount", fields: [origin_account_id], references: [account_id])
    account_id                  String
    origin_account_id           String?
    TargetAccountPartition      AccountPartition? @relation(name: "TargetAccountPartition", fields: [target_account_partition_id], references: [account_partition_id])
    OriginAccountPartition      AccountPartition? @relation(name: "OriginAccountPartition", fields: [origin_account_partition_id], references: [account_partition_id])
    target_account_partition_id String?
    origin_account_partition_id String?

    Category                Category?                @relation(fields: [category_id], references: [category_id])
    category_id             String?
    Tags                    Tag[]                    @relation("BudgetTags")
    TransactionAttributions TransactionAttribution[]
    Group                   Group?                   @relation(fields: [group_id], references: [group_id])
    group_id                String?
}

model BudgetScheduleVariant {
    schedule_variant_id String @id @default(uuid())
    Budget              Budget @relation(fields: [budget_id], references: [budget_id])
    budget_id           String

    // TODO CHECK THESE AT SAVE
    amount              Float // e.g.
    schedule            Json // e.g. cron expression, interval, etc.
    window_interval     String?
    window_quantity     Int?
    projection_interval String?
    projection_quantity Int?
}

model BudgetTriggerVariant {
    trigger_variant_id String @id @default(uuid())
    Budget             Budget @relation(fields: [budget_id], references: [budget_id])
    budget_id          String

    // TODO CHECK THESE AT SAVE
    start            String? // date only e.g. "2023-10-01"
    end              String? // date only e.g. "2023-12-31"
    trigger_filter   Json // e.g. filter to apply to transactions, like category, amount, etc.
    trigger_operator String // e.g. add, subtract, multiply, divide
    trigger_operand  Float
}

enum CategoryType {
    EXPENSE
    INCOME
    TRANSFER
}

model Category {
    category_id String       @id @default(uuid())
    name        String
    type        CategoryType

    Workspace    Workspace? @relation(fields: [workspace_id], references: [workspace_id])
    workspace_id String

    Budgets                  Budget[]
    TransactionAttributions  TransactionAttribution[]
    Group                    CategoryGroup              @relation(fields: [group_id], references: [group_id])
    group_id                 String
    CategoryDetectionMapping CategoryDetectionMapping[]
}

model CategoryGroup {
    group_id     String     @id @default(uuid())
    name         String
    Workspace    Workspace? @relation(fields: [workspace_id], references: [workspace_id])
    workspace_id String
    Categories   Category[]
}

model CategoryDetectionMapping {
    Workspace    Workspace? @relation(fields: [workspace_id], references: [workspace_id])
    workspace_id String

    detection_key String // plaid category names
    Category      Category @relation(fields: [category_id], references: [category_id])
    category_id   String

    @@id([workspace_id, detection_key])
}

model Tag {
    tag_id                  String                   @id @default(uuid())
    name                    String
    Workspace               Workspace?               @relation(fields: [workspace_id], references: [workspace_id])
    workspace_id            String
    Budgets                 Budget[]                 @relation("BudgetTags")
    TransactionAttributions TransactionAttribution[] @relation("TransactionTags")
}

model Group {
    group_id                String                   @id @default(uuid())
    name                    String
    Workspace               Workspace?               @relation(fields: [workspace_id], references: [workspace_id])
    workspace_id            String
    Budgets                 Budget[]
    TransactionAttributions TransactionAttribution[]
}

// Real transaction, created manually or imported from source (plaid)
model Transaction {
    transaction_id       String  @id @default(uuid())
    amount               Float
    date                 String // DATE ONLY  e.g. "2023-10-01"
    authorized_date      String? // e.g. for credit card transactions, the date the transaction was authorized
    iso_currency_code    String?
    notes                String?
    original_description String // e.g. "Starbucks 1234"
    pending              Boolean @default(false)
    done_pending         Boolean @default(false) // e.g. if the transaction was pending, but has been processed. Pending should also be true

    location_address String? // e.g. "123 Main St, Anytown, USA"
    location_lat     Float? // e.g. 37.7749
    location_lon     Float? // e.g. -122.4194
    location_city    String? // e.g. "San Francisco"
    location_region  String? // e.g. "CA"
    location_postal  String? // e.g. "94103"

    source      String // e.g. "plaid", "manual", "imported"
    source_id   String? // e.g. plaid transaction id, manual transaction id, imported transaction id
    source_data Json? // e.g. plaid transaction data, imported transaction data

    // A single transaction cannot be split between accounts
    Account      Account                  @relation(fields: [account_id], references: [account_id])
    account_id   String
    Merchant     Merchant?                @relation(fields: [merchant_id], references: [merchant_id])
    merchant_id  String?
    Attributions TransactionAttribution[]

    ParentCategory         Transaction?  @relation("PendingTransaction", fields: [pending_transaction_id], references: [transaction_id])
    child_categories       Transaction[] @relation("PendingTransaction")
    pending_transaction_id String?

    Workspace    Workspace @relation(fields: [workspace_id], references: [workspace_id])
    workspace_id String
}

// To keep like data all in one place, this table holds data for ALL transactions, even without splits
// Data w/o splits just have a single entry, and splits have multiple
model TransactionAttribution {
    transaction_attribution_id String  @id @default(uuid())
    amount                     Float // TODO ADD MANY CHECKS THAT THESE ALWAYS ADD UP TO THE TRANSACTION AMOUNT
    memo                       String?

    Transaction    Transaction @relation(fields: [transaction_id], references: [transaction_id])
    transaction_id String

    AccountPartition     AccountPartition? @relation(fields: [account_partition_id], references: [account_partition_id])
    account_partition_id String?
    Category             Category?         @relation(fields: [category_id], references: [category_id])
    category_id          String?
    Tags                 Tag[]             @relation("TransactionTags")
    Budget               Budget?           @relation(fields: [budget_id], references: [budget_id])
    budget_id            String?
    Group                Group?            @relation(fields: [group_id], references: [group_id])
    group_id             String?
}

model Merchant {
    merchant_id       String        @id @default(uuid())
    name              String
    logo              String?
    plaid_merchant_id String? // e.g. plaid merchant id, manual merchant id, imported merchant id
    Transaction       Transaction[]
}
