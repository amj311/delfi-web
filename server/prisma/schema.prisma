// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
    user_id     String     @id @default(uuid())
    email       String     @unique
    given_name  String
    family_name String
    // accounts    Account[]
    categories  Category[]
    tags        Tag[]
    // PlaidItem   PlaidItem[]

    @@map("user")
}

model Account {
    account_id          String  @id @default(uuid())
    external_account_id String? @unique
    name                String
    official_name       String?
    mask                String?
    type                String
    subtype             String
    current_balance     Decimal?
    available_balance   Decimal?
    iso_currency_code   String?

    // relations
    plaid_item    PlaidItem?    @relation(fields: [plaid_item_id], references: [plaid_item_id])
    // user          User          @relation(fields: [user_id], references: [user_id])
    // user_id       String
    transactions  Transaction[]
    plaid_item_id String?

    @@map("account")
}

model PlaidItem {
    plaid_item_id  String    @id
    access_token   String
    accounts       Account[]
    institution_id String?
    // user           User      @relation(fields: [user_id], references: [user_id])
    // user_id        String

    @@map("plaid_item")
}

