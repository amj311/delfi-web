{
  "name": "delfi-web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check build-only",
    "server:dev": "tsx watch server/index.ts",
    "server": "tsx server/index.ts",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false",
    "db:push": "cd prisma && npx prisma db push",
    "db:generate": "cd prisma && npx prisma generate",
    "local-prod": "docker compose -f docker-compose-prod-local.yml up -d --build --force-recreate > /dev/null"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/static": "^8.2.0",
    "@prisma/client": "^5.2.0",
    "@rschedule/core": "^1.5.0",
    "@rschedule/dayjs-date-adapter": "^1.5.0",
    "@types/uuid": "^9.0.3",
    "axios": "^1.5.0",
    "dayjs": "^1.11.9",
    "dotenv": "^16.3.1",
    "fastify": "^5.0.0",
    "firebase-admin": "^11.10.1",
    "plaid": "^15.5.0",
    "playwright": "^1.53.0",
    "prisma": "^5.2.0",
    "tsx": "^4.20.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "apexcharts": "^5.3.5",
    "@primeuix/themes": "^1.1.2",
    "@tsconfig/node18": "^18.2.0",
    "@types/jsdom": "^21.1.1",
    "@types/node": "^18.17.5",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vitejs/plugin-vue-jsx": "^4.0.1",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.5.1",
    "firebase": "^10.4.0",
    "jsdom": "^22.1.0",
    "npm-run-all": "^4.1.5",
    "pinia": "^2.2.4",
    "primeflex": "^4.0.0",
    "primeicons": "^7.0.0",
    "primevue": "^4.3.5",
    "sass": "^1.89.2",
    "typescript": "~5.6.3",
    "vite": "^5.4.8",
    "vitest": "^2.1.2",
    "vue": "^3.5.12",
    "vue-router": "^4.4.5",
    "vue-tsc": "^2.1.10",
    "vue3-apexcharts": "^1.8.0"
  }
}
